      },
      {
        "name": "AZURE_SPEECH_USE_MANAGED_IDENTITY",
        "value": "true"
      }
    ],
    "githubSecrets": "[if(empty(parameters('githubToken')), createArray(), createArray(createObject('name', 'github-token', 'value', parameters('githubToken'))))]",
    "authSecrets": "[if(parameters('enableExternalIngress'), createArray(createObject('name', 'entra-client-secret', 'value', variables('validatedEntraClientSecret'))), createArray())]",
    "webSecrets": "[concat(variables('githubSecrets'), variables('authSecrets'))]",
    "jobOperatorRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b9a307c4-5aa3-4b52-ba60-2b17c136cd7b')]"

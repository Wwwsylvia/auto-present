        "principalType": "[parameters('localOperatorPrincipalType')]",
        "roleDefinitionId": "[variables('speechUserRoleId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('speechName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[variables('webAppName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('workloadTags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName')))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "configuration": "[union(createObject('activeRevisionsMode', 'Single', 'registries', createArray(createObject('identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName')), 'server', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer)), 'secrets', variables('webSecrets')), createObject('ingress', createObject('allowInsecure', false(), 'external', false(), 'targetPort', 3000, 'traffic', createArray(createObject('latestRevision', true(), 'weight', 100)), 'transport', 'Auto')))]",
        "template": {
          "containers": [
            {
              "name": "web",
              "image": "[variables('image')]",
              "env": "[concat(variables('dataEnvironment'), variables('foundryEnvironment'), createArray(createObject('name', 'APP_HOSTING_MODE', 'value', 'azure'), createObject('name', 'AZURE_CLIENT_ID', 'value', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName')), '2023-01-31').clientId), createObject('name', 'AZURE_SUBSCRIPTION_ID', 'value', subscription().subscriptionId), createObject('name', 'AZURE_RESOURCE_GROUP', 'value', resourceGroup().name), createObject('name', 'AZURE_CONTAINER_APP_JOB_NAME', 'value', variables('renderJobName')), createObject('name', 'RENDER_EXECUTION_MODE', 'value', 'container-apps-job')), if(empty(parameters('githubToken')), createArray(), createArray(createObject('name', 'GITHUB_TOKEN', 'secretRef', 'github-token'))))]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/api/health",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 30,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/api/health",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                }
              ],
              "volumeMounts": [
                {
                  "mountPath": "[variables('dataMountPath')]",
                  "volumeName": "shared-data"
                }
              ]
            }
          ],
          "scale": {
            "maxReplicas": 1,
            "minReplicas": "[if(parameters('enableExternalIngress'), 1, 0)]"
          },
          "volumes": [
            {
              "name": "shared-data",
              "storageName": "[variables('environmentStorageName')]",
              "storageType": "AzureFile"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', variables('environmentName'), variables('environmentStorageName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), parameters('foundryProjectName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/deployments', variables('foundryName'), parameters('modelDeploymentName'))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName')), variables('acrPullRoleId')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName'))]",
        "[extensionResourceId(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName')), variables('openAiUserRoleId')))]"
      ]
    },
    {
      "condition": "[parameters('enableExternalIngress')]",
      "type": "Microsoft.App/containerApps/authConfigs",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', variables('webAppName'), 'current')]",
      "properties": {
        "platform": {
          "enabled": true
        },
        "globalValidation": {
          "unauthenticatedClientAction": "RedirectToLoginPage",
          "redirectToProvider": "azureactivedirectory"
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": true,
            "registration": {
              "clientId": "[variables('validatedEntraClientId')]",
              "clientSecretSettingName": "entra-client-secret",
              "openIdIssuer": "[format('{0}{1}/v2.0', variables('authenticationLoginEndpoint'), variables('validatedEntraTenantId'))]"
            },
            "validation": {
              "allowedAudiences": [
                "[variables('validatedEntraClientId')]",
                "[format('api://{0}', variables('validatedEntraClientId'))]"
              ]
            }
          }
        },
        "login": {
          "tokenStore": {
            "enabled": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('webAppName'))]"
      ]
    },
    {
      "type": "Microsoft.App/jobs",
      "apiVersion": "2025-01-01",
      "name": "[variables('renderJobName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('workloadTags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName')))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "configuration": {
          "replicaRetryLimit": 0,
          "replicaTimeout": 3600,
          "registries": [
            {
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName'))]",
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]"
            }
          ],
          "secrets": [],
          "triggerType": "Manual",
          "manualTriggerConfig": {
            "parallelism": 1,
            "replicaCompletionCount": 1
          }
        },
        "template": {
          "containers": [
            {
              "name": "render",
              "image": "[variables('image')]",
              "command": [
                "npm",
                "run",
                "render:worker"
              ],
              "env": "[concat(variables('dataEnvironment'), variables('speechEnvironment'), createArray(createObject('name', 'AZURE_CLIENT_ID', 'value', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName')), '2023-01-31').clientId)))]",
              "resources": {
                "cpu": "[json('1.0')]",
                "memory": "2Gi"
              },
              "volumeMounts": [
                {
                  "mountPath": "[variables('dataMountPath')]",
                  "volumeName": "shared-data"
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "shared-data",
              "storageName": "[variables('environmentStorageName')]",
              "storageType": "AzureFile"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', variables('environmentName'), variables('environmentStorageName'))]",
        "[extensionResourceId(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName')), variables('acrPullRoleId')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName'))]",
        "[extensionResourceId(resourceId('Microsoft.CognitiveServices/accounts', variables('speechName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.CognitiveServices/accounts', variables('speechName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName')), variables('speechUserRoleId')))]",
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('speechName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.App/jobs', variables('renderJobName'))]",
      "name": "[guid(resourceId('Microsoft.App/jobs', variables('renderJobName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName')), variables('jobOperatorRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[variables('jobOperatorRoleId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/jobs', variables('renderJobName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupId": {
      "type": "string",
      "value": "[resourceGroup().id]"
    },
    "registryId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]"
    },
    "registryName": {
      "type": "string",
      "value": "[variables('acrName')]"
    },
    "registryLoginServer": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]"
    },
    "logAnalyticsId": {
      "type": "string",
      "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
    },
    "containerAppsEnvironmentId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/managedEnvironments', variables('environmentName'))]"
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "value": "[variables('environmentName')]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "fileShareName": {
      "type": "string",
      "value": "[variables('fileShareName')]"
    },
    "foundryAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
    },
    "foundryAccountName": {
      "type": "string",
      "value": "[variables('foundryName')]"
    },
    "foundryProjectId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryName'), parameters('foundryProjectName'))]"
    },
    "foundryProjectName": {
      "type": "string",
      "value": "[parameters('foundryProjectName')]"
    },
    "foundryProjectEndpoint": {
      "type": "string",
      "value": "[variables('projectEndpoint')]"
    },
    "modelDeploymentName": {
      "type": "string",
      "value": "[parameters('modelDeploymentName')]"
    },
    "speechAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', variables('speechName'))]"
    },
    "speechAccountName": {
      "type": "string",
      "value": "[variables('speechName')]"
    },
    "speechEndpoint": {
      "type": "string",
      "value": "[format('https://{0}.cognitiveservices.azure.com/', variables('speechName'))]"
    },
    "speechRegion": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "webIdentityId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('webIdentityName'))]"
    },
    "jobIdentityId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName'))]"
    },
    "webContainerAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/containerApps', variables('webAppName'))]"
    },
    "webContainerAppName": {
      "type": "string",
      "value": "[variables('webAppName')]"
    },
    "webHost": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('webAppName')), '2025-01-01').configuration.ingress.fqdn]"
    },
    "externalIngressRequested": {
      "type": "bool",
      "value": "[parameters('enableExternalIngress')]"
    },
    "externalIngressEnabled": {
      "type": "bool",
      "value": false
    },
    "entraAuthenticationEnabled": {
      "type": "bool",
      "value": "[parameters('enableExternalIngress')]"
    },
    "renderJobId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/jobs', variables('renderJobName'))]"
    },
    "renderJobName": {
      "type": "string",
      "value": "[variables('renderJobName')]"
    }
  }
}
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('speechName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName')), variables('speechUserRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[variables('speechUserRoleId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('jobIdentityName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('speechName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('localOperatorPrincipalId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName')), parameters('localOperatorPrincipalId'), variables('openAiUserRoleId'))]",
      "properties": {
        "principalId": "[parameters('localOperatorPrincipalId')]",
        "principalType": "[parameters('localOperatorPrincipalType')]",
        "roleDefinitionId": "[variables('openAiUserRoleId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('localOperatorPrincipalId')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('speechName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('speechName')), parameters('localOperatorPrincipalId'), variables('speechUserRoleId'))]",
      "properties": {

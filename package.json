{
  "name": "idea2impact",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/local-run.mjs dev",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/local-run.mjs start",
    "start:web": "next start --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker/render-worker.ts",
    "acceptance": "node --env-file-if-exists=.env.local --import tsx scripts/acceptance.mts",
    "acceptance:self": "node --env-file-if-exists=.env.local --import tsx scripts/self-acceptance.mts",
    "preflight": "node --env-file-if-exists=.env.local scripts/preflight.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@azure/ai-projects": "^2.4.0",
    "@azure/identity": "^4.13.1",
    "next": "16.3.1-canary.5",
    "openai": "^6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1-canary.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
